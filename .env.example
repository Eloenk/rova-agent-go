# Rova Agent Go Engine Environment Credentials Example
# Local-only opt-in; deployed environments should inject variables from a secret manager.
ROVA_LOAD_DOTENV=false

# AI Provider API Keys
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
ROVA_AI_MODEL=

# Circle Developer Controlled Wallets
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=

# Engine access and execution gates. Mainnet execution is hard-disabled in this release.
EXECUTION_MODE=circle
ROVA_ENGINE_BIND=127.0.0.1
ROVA_ENGINE_API_TOKEN=
ROVA_EXECUTION_ENABLED=false
ROVA_AUTONOMOUS_EXECUTION_ENABLED=false
ROVA_WHATSAPP_EXECUTION_ENABLED=false
ROVA_MAX_AUTONOMOUS_AMOUNT_USDC=100
ROVA_MAX_WHATSAPP_AMOUNT_USDC=100

# Supabase secret access (server-side only; never expose SUPABASE_SECRET_KEY)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional Realtime transport; REST polling is used when blank.
SUPABASE_PUBLISHABLE_KEY=

# Authenticated compatibility sidecar. Quote and execution endpoints are disabled.
ROVA_SIDECAR_TOKEN=
ROVA_SWAP_SOCKET=/tmp/rova-swap.sock
SWAP_SIDECAR_PORT=
ARC_CHAIN=Arc
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_WSS_URL=wss://rpc.mainnet.arc.io
ROVA_VAULT_STRATEGY=disabled
ROVA_SAVINGS_VAULT_ADDRESS=
ROVA_SWAP_STRATEGY=disabled
NEXT_PUBLIC_ROVA_SWAP_ROUTER_ADDRESS=

# Optional deployment metadata. Do not configure a transaction-signing key in the runtime service.
ROVA_AGENT_PRIVATE_KEY=
NEXT_PUBLIC_ROVA_EXECUTION_LOG_ADDRESS=
